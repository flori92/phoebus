GEMINI_API_KEY=VOTRE_CLE_ICI
YOUTUBE_API_KEY=VOTRE_CLE_ICI
HA_URL=http://homeassistant.local:8123
HA_TOKEN=VOTRE_TOKEN_ICI
XAI_API_KEY=VOTRE_CLE_ICI
SERPAPI_API_KEY=VOTRE_CLE_ICI
GROQ_API_KEY=VOTRE_CLE_ICI
MISTRAL_API_KEY=VOTRE_CLE_ICI
ARENA_URL=http://localhost:8000/api/v1
ARENA_API_KEY=arena
ARENA_MODEL=gemini-2.5-flash
ARENA_DEEP_MODEL=claude-sonnet-4-5-20250929
ARENA_TIMEOUT=30
ARENA_MODEL_CANDIDATES=gemini-2.5-flash,gemini-3-flash,gemini-2.0-flash-001,Max
ARENA_DEEP_MODEL_CANDIDATES=claude-sonnet-4-5-20250929,claude-3-5-sonnet-20241022,gemini-2.5-pro,gemini-3.1-pro-preview
PHOEBUS_ARENA_BRIDGE_AUTO_START=auto
PHOEBUS_ARENA_BRIDGE_AUTO_INSTALL=0
PHOEBUS_ARENA_BRIDGE_AUTO_UPDATE=0
PHOEBUS_ARENA_BRIDGE_ALLOW_ANONYMOUS=1
PHOEBUS_ARENA_BRIDGE_LOG=logs/arena_bridge.log
ARENA_AUTH_PROD_V1=
ARENA_CF_CLEARANCE=
PHOEBUS_WS_TOKEN=CHANGE_ME
PHOEBUS_DEVICES_FILE=phoebus_devices.json
PHOEBUS_AUDIT_FILE=logs/audit.jsonl

# ── Cerveau IA multi-provider ─────────────────────────────────────────
# PHOEBUS_BRAIN_MODE = balanced | speed | smart | privacy
PHOEBUS_BRAIN_MODE=balanced
PHOEBUS_BRAIN_ORDER=gemini,groq,arena,mistral,grok,ollama
PHOEBUS_BRAIN_FAST_TIMEOUT=7
PHOEBUS_BRAIN_TIMEOUT=10
PHOEBUS_BRAIN_SMART_TIMEOUT=14

PHOEBUS_GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
GROK_MODEL=grok-3
MISTRAL_MODEL=mistral-small-latest
PHOEBUS_OLLAMA_MODELS=mistral:instruct,mistral,llama3:8b,llama3,gemma4

CREATOR_NAME=Floriace
CREATOR_GITHUB=flori92
CREATOR_TIMEZONE=Europe/Paris

# ── TTS (synthèse vocale) ──────────────────────────────────────────────
# PHOEBUS_TTS_BACKEND = auto | piper | edge | eleven
PHOEBUS_TTS_BACKEND=auto
EDGE_VOICE=fr-FR-RemyMultilingualNeural
EDGE_RATE=+4%
EDGE_PITCH=-2Hz
EDGE_VOLUME=+0%

# Piper TTS local
PHOEBUS_PIPER_MODEL=
PHOEBUS_PIPER_CONFIG=
PHOEBUS_PIPER_LENGTH=0.95
PHOEBUS_PIPER_NOISE=0.667
PHOEBUS_PIPER_NOISE_W=0.8

# ElevenLabs TTS ultra-naturel (payant)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=ErXwobaYiN019PkySvjV
ELEVEN_MODEL=eleven_multilingual_v2

# ── STT (reconnaissance vocale) ────────────────────────────────────────
# PHOEBUS_STT_BACKEND = auto | google | whisper
# Whisper requis : pip install faster-whisper
PHOEBUS_STT_BACKEND=auto
PHOEBUS_WHISPER_MODEL=base

# ── Wake Word "Hey PHOEBUS" ─────────────────────────────────────────────
# Tous les backends sont 100% gratuits et 100% locaux.
# Désactivé par défaut pour éviter deux accès micro simultanés sur macOS.
# Le STT principal détecte déjà "PHOEBUS" dans la phrase.
PHOEBUS_WAKE_ENABLED=0
#
# Backend forcé (auto = essai dans l'ordre OWW → Vosk → Pocketsphinx → STT)
# PHOEBUS_WAKE_BACKEND = auto | oww | vosk | pocketsphinx | stt
PHOEBUS_WAKE_BACKEND=auto

# Seuil de confiance OpenWakeWord (0.0-1.0)
PHOEBUS_OWW_THRESHOLD=0.5
# Cooldown entre deux déclenchements (secondes)
PHOEBUS_WAKE_COOLDOWN=2.0

# Vosk (Apache 2.0, hors ligne, très précis)
# Chemin RELATIF au dossier du projet (fonctionne sur Windows, macOS, Linux)
# install.py télécharge et configure ce chemin automatiquement.
PHOEBUS_VOSK_MODEL_PATH=models/vosk-model-small-fr-0.22

# ── Spotify ────────────────────────────────────────────────────────────
# Créer une app sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
# Nom du device Spotify cible (laisser vide pour le device actif)
SPOTIFY_DEVICE_NAME=

# ── Multi-utilisateurs ─────────────────────────────────────────────────
# Activer la reconnaissance vocale par speaker (0 ou 1)
PHOEBUS_MULTI_USER=0
# Seuil de confiance d'identification (0.0-1.0)
PHOEBUS_SPEAKER_THRESHOLD=0.75

# ── Briefing matinal ───────────────────────────────────────────────────
# Heure du briefing automatique (format 24h, entier)
PHOEBUS_BRIEFING_HOUR=8
# Activer la musique de réveil Spotify (0 ou 1)
PHOEBUS_BRIEFING_MUSIC=0
# Playlist de réveil Spotify (nom ou query)
PHOEBUS_BRIEFING_PLAYLIST=morning jazz
# Inclure les actualités dans le briefing (0 ou 1)
PHOEBUS_BRIEFING_NEWS=1

# ── Caméras (PC webcam, téléphone via WebSocket, caméras IP/RTSP) ──────
# Nécessite : pip install opencv-python  (déjà installé d'après le rapport)
# Index OpenCV de la webcam (0 = caméra interne, 1+ = USB externes)
PHOEBUS_CAMERA_PC_INDEX=0
# Délai max d'attente pour la caméra du téléphone (secondes)
PHOEBUS_CAMERA_PHONE_TIMEOUT=8
# URL d'une caméra IP par défaut (snapshot HTTP, MJPEG, RTSP). Optionnel.
# Exemples : http://192.168.1.20/snapshot.jpg
#           rtsp://user:pass@192.168.1.20:554/stream1
PHOEBUS_CAMERA_IP_URL=

# ── Observabilité (PHOEBUS/observability.py) ───────────────────────────
# Endpoints HTTP exposés sur le port mobile (8090 par défaut) :
#   GET /metrics    → JSON p50/p95/p99 par phase (STT, LLM, TTS, vision...)
#   GET /dashboard  → page HTML auto-refresh 5s
#   GET /health     → cooldowns LLM + état conversation/speaking

# ── Backend mémoire : local (par défaut) ou postgres (multi-device) ────
# Postgres requiert : pip install "psycopg[binary]" + DB avec pgvector.
PHOEBUS_MEMORY_BACKEND=local
# DATABASE_URL=postgresql://user:pass@host:5432/PHOEBUS
# PHOEBUS_EMBEDDING_DIMS=768

# ── Function calling natif Gemini (opt-in) ─────────────────────────────
PHOEBUS_USE_FUNCTION_CALLING=0

# ── Playwright (browser automation, optionnel) ─────────────────────────
PLAYWRIGHT_HEADLESS=0
PLAYWRIGHT_TIMEOUT_MS=15000

# ── Découverte LAN et contrôle objets connectés ────────────────────────
# zeroconf (mDNS) recommandé pour la découverte des Apple TV / Chromecast :
#     pip install zeroconf
# Aucune autre config requise — la découverte ARP fonctionne nativement.

# ── MQTT direct (objets connectés type Tasmota, Shelly, ESP32, Z2M) ────
# pip install paho-mqtt
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0
MQTT_CLIENT_ID=phoebus

# ── Connaissance externe (Wikipedia toujours actif, Wolfram en option) ──
WIKIPEDIA_LANG=fr
# Wolfram Alpha pour les calculs scientifiques. Compte gratuit 2000/mois :
# https://products.wolframalpha.com/api
WOLFRAM_APP_ID=
# GitHub token pour la recherche de code (sinon non authentifié, limité).
GITHUB_TOKEN=
# Flux RSS pour les actualités (CSV d'URLs).
PHOEBUS_RSS_FEEDS=https://www.lemonde.fr/rss/une.xml,https://www.france24.com/fr/rss

# ── Cast (AirPlay / Chromecast) ────────────────────────────────────────
# Optionnels :
#     pip install pychromecast    pour Chromecast / Google Cast
#     pip install pyatv           pour AirPlay (Apple TV)
