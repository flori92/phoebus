GEMINI_API_KEY=VOTRE_CLE_ICI
YOUTUBE_API_KEY=VOTRE_CLE_ICI
HA_URL=http://homeassistant.local:8123
HA_TOKEN=VOTRE_TOKEN_ICI
XAI_API_KEY=VOTRE_CLE_ICI
SERPAPI_API_KEY=VOTRE_CLE_ICI
GROQ_API_KEY=VOTRE_CLE_ICI
JARVIS_WS_TOKEN=CHANGE_ME
JARVIS_DEVICES_FILE=jarvis_devices.json
JARVIS_AUDIT_FILE=logs/audit.jsonl

CREATOR_NAME=Floriace
CREATOR_GITHUB=flori92
CREATOR_TIMEZONE=Europe/Paris

# ── TTS (synthèse vocale) ──────────────────────────────────────────────
# JARVIS_TTS_BACKEND = auto | piper | edge | eleven
# auto : Piper (si modèle configuré) > ElevenLabs (si clé) > Edge-TTS
JARVIS_TTS_BACKEND=auto

# Edge-TTS (gratuit, Microsoft non officiel). Voix multilingues récentes
# plus expressives qu'HenriNeural : fr-FR-RemyMultilingualNeural (H) ou
# fr-FR-VivienneMultilingualNeural (F). rate/pitch en SSML.
EDGE_VOICE=fr-FR-RemyMultilingualNeural
EDGE_RATE=+4%
EDGE_PITCH=-2Hz
EDGE_VOLUME=+0%

# Piper (local, gratuit, offline, rapide sur CPU).
# pip install piper-tts  +  télécharger un modèle :
#   https://huggingface.co/rhasspy/piper-voices/tree/main/fr/fr_FR/siwis/medium
# Pointe JARVIS_PIPER_MODEL vers le .onnx (le .onnx.json est détecté à côté).
JARVIS_PIPER_MODEL=
JARVIS_PIPER_CONFIG=
JARVIS_PIPER_LENGTH=0.95
JARVIS_PIPER_NOISE=0.667
JARVIS_PIPER_NOISE_W=0.8

# ElevenLabs (payant, ultra-naturel). Laisse vide si tu n'en veux pas.
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=ErXwobaYiN019PkySvjV
ELEVEN_MODEL=eleven_multilingual_v2

# ── STT (reconnaissance vocale) ────────────────────────────────────────
# JARVIS_STT_BACKEND = auto | google | whisper
# Whisper requiert `pip install openai-whisper` ou `pip install faster-whisper`.
JARVIS_STT_BACKEND=auto
JARVIS_WHISPER_MODEL=base
