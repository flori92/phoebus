GEMINI_API_KEY=VOTRE_CLE_ICI
YOUTUBE_API_KEY=VOTRE_CLE_ICI
HA_URL=http://homeassistant.local:8123
HA_TOKEN=VOTRE_TOKEN_ICI
XAI_API_KEY=VOTRE_CLE_ICI
SERPAPI_API_KEY=VOTRE_CLE_ICI
GROQ_API_KEY=VOTRE_CLE_ICI
MISTRAL_API_KEY=VOTRE_CLE_ICI
JARVIS_WS_TOKEN=CHANGE_ME
JARVIS_DEVICES_FILE=jarvis_devices.json
JARVIS_AUDIT_FILE=logs/audit.jsonl

# ── Cerveau IA multi-provider ─────────────────────────────────────────
# JARVIS_BRAIN_MODE = balanced | speed | smart | privacy
JARVIS_BRAIN_MODE=balanced
JARVIS_BRAIN_ORDER=gemini,groq,mistral,grok,ollama
JARVIS_BRAIN_FAST_TIMEOUT=7
JARVIS_BRAIN_TIMEOUT=10
JARVIS_BRAIN_SMART_TIMEOUT=14

JARVIS_GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
GROK_MODEL=grok-3
MISTRAL_MODEL=mistral-small-latest
JARVIS_OLLAMA_MODELS=mistral:instruct,mistral,llama3:8b,llama3,gemma4

CREATOR_NAME=Floriace
CREATOR_GITHUB=flori92
CREATOR_TIMEZONE=Europe/Paris

# ── TTS (synthèse vocale) ──────────────────────────────────────────────
# JARVIS_TTS_BACKEND = auto | piper | edge | eleven
JARVIS_TTS_BACKEND=auto
EDGE_VOICE=fr-FR-RemyMultilingualNeural
EDGE_RATE=+4%
EDGE_PITCH=-2Hz
EDGE_VOLUME=+0%

# Piper TTS local
JARVIS_PIPER_MODEL=
JARVIS_PIPER_CONFIG=
JARVIS_PIPER_LENGTH=0.95
JARVIS_PIPER_NOISE=0.667
JARVIS_PIPER_NOISE_W=0.8

# ElevenLabs TTS ultra-naturel (payant)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=ErXwobaYiN019PkySvjV
ELEVEN_MODEL=eleven_multilingual_v2

# ── STT (reconnaissance vocale) ────────────────────────────────────────
# JARVIS_STT_BACKEND = auto | google | whisper
# Whisper requis : pip install faster-whisper
JARVIS_STT_BACKEND=auto
JARVIS_WHISPER_MODEL=base

# ── Wake Word "Hey Jarvis" ─────────────────────────────────────────────
# Tous les backends sont 100% gratuits et 100% locaux.
# Désactivé par défaut pour éviter deux accès micro simultanés sur macOS.
# Le STT principal détecte déjà "Jarvis" dans la phrase.
JARVIS_WAKE_ENABLED=0
#
# Backend forcé (auto = essai dans l'ordre OWW → Vosk → Pocketsphinx → STT)
# JARVIS_WAKE_BACKEND = auto | oww | vosk | pocketsphinx | stt
JARVIS_WAKE_BACKEND=auto

# Seuil de confiance OpenWakeWord (0.0-1.0)
JARVIS_OWW_THRESHOLD=0.5
# Cooldown entre deux déclenchements (secondes)
JARVIS_WAKE_COOLDOWN=2.0

# Vosk (Apache 2.0, hors ligne, très précis)
# Chemin RELATIF au dossier du projet (fonctionne sur Windows, macOS, Linux)
# install.py télécharge et configure ce chemin automatiquement.
JARVIS_VOSK_MODEL_PATH=models/vosk-model-small-fr-0.22

# ── Spotify ────────────────────────────────────────────────────────────
# Créer une app sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
# Nom du device Spotify cible (laisser vide pour le device actif)
SPOTIFY_DEVICE_NAME=

# ── Multi-utilisateurs ─────────────────────────────────────────────────
# Activer la reconnaissance vocale par speaker (0 ou 1)
JARVIS_MULTI_USER=0
# Seuil de confiance d'identification (0.0-1.0)
JARVIS_SPEAKER_THRESHOLD=0.75

# ── Briefing matinal ───────────────────────────────────────────────────
# Heure du briefing automatique (format 24h, entier)
JARVIS_BRIEFING_HOUR=8
# Activer la musique de réveil Spotify (0 ou 1)
JARVIS_BRIEFING_MUSIC=0
# Playlist de réveil Spotify (nom ou query)
JARVIS_BRIEFING_PLAYLIST=morning jazz
# Inclure les actualités dans le briefing (0 ou 1)
JARVIS_BRIEFING_NEWS=1
