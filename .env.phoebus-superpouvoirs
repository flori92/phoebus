# ═══════════════════════════════════════════════════════════════════════════
# 🌟 PHOEBUS — Configuration Complète des 7 Super-Pouvoirs
# ═══════════════════════════════════════════════════════════════════════════
# Généré: 26 avril 2026 pour Floriace
# Configuration 100% optimisée pour performance, qualité audio, et intelligence

# ───────────────────────────────────────────────────────────────────────────
# 🔑 CLÉS API (Remplir avec vos valeurs réelles)\n# ───────────────────────────────────────────────────────────────────────────

GEMINI_API_KEY=votre_clé_gemini_ici
OPENAI_API_KEY=votre_clé_openai_ici
GROQ_API_KEY=votre_clé_groq_ici
XAI_API_KEY=votre_clé_xai_grok_ici
MISTRAL_API_KEY=votre_clé_mistral_ici
KIMI_API_KEY=votre_clé_kimi_ici

# ───────────────────────────────────────────────────────────────────────────
# 🧠 LMARENA BRIDGE — Super-Pouvoir #5 (Conscience + Réflexion Profonde)
# ───────────────────────────────────────────────────────────────────────────

# URL du bridge local (si actif) ou cloud
ARENA_URL=http://localhost:8000/api/v1

# Clé API Arena (nominale, le bridge gère l'authentification)
ARENA_API_KEY=arena

# Timeout pour requêtes Arena (augmenté pour la réflexion profonde)
ARENA_TIMEOUT=60

# Modèles candidates pour réponses rapides (chat)
ARENA_MODEL_CANDIDATES=gemini-2.5-flash,claude-3.5-haiku,gemini-2.0-flash-001

# Modèles candidates pour réflexion profonde (analyses, stratégie)
ARENA_DEEP_MODEL_CANDIDATES=claude-3.5-sonnet-20241022,claude-opus-4-1-20250805,gemini-3-pro,gemini-2.5-pro

# Mode de démarrage LMArenaBridge automatique (auto/on/off)
PHOEBUS_ARENA_BRIDGE_AUTO_START=auto

# Fichier log du bridge Arena
PHOEBUS_ARENA_BRIDGE_LOG=logs/arena_bridge.log

# ───────────────────────────────────────────────────────────────────────────
# 🧠 ROUTEUR IA — Intelligence Adaptative
# ───────────────────────────────────────────────────────────────────────────

# Ordre de priorité des fournisseurs IA
# Options: gemini, groq, arena, openai, mistral, kimi, grok, ollama
PHOEBUS_BRAIN_ORDER=gemini,groq,arena,openai,mistral,kimi,grok,ollama

# Mode de routage intelligent
# Options: balanced (défaut), speed (minimum latence), smart (meilleure réponse), privacy (local-first)
PHOEBUS_BRAIN_MODE=smart

# ───────────────────────────────────────────────────────────────────────────
# 🎙️ AUDIO ROBUSTE — Super-Pouvoir #1 (Qualité d'Écoute)
# ───────────────────────────────────────────────────────────────────────────

# Activation de l'optimisation audio complète (VAD, AEC, AGC)
PHOEBUS_AUDIO_OPTIMIZATION=1

# Suppression écho acoustique (Acoustic Echo Cancellation)
PHOEBUS_ENABLE_AEC=1

# Noise gate (suppression bruit inférieur à threshold)
PHOEBUS_ENABLE_NOISE_GATE=1

# Auto Gain Control (normalisation gain automatique)
PHOEBUS_ENABLE_AGC=1

# Mode agressivité VAD (0=low, 1=mid, 2=high, 3=very_high)
# Valeur plus élevée = rejette plus d'audio non-parole
PHOEBUS_VAD_MODE=2

# Seuil bruit (RMS, 0.0-1.0). En-dessous = silence
PHOEBUS_NOISE_THRESHOLD=0.02

# Niveau cible AGC (0.0-1.0)
PHOEBUS_AGC_TARGET_LEVEL=0.5

# Backend STT (auto/groq/google/whisper)
# auto = détecte le meilleur disponible
PHOEBUS_STT_BACKEND=auto

# Modèle Whisper (tiny/base/small/medium/large)
# tiny = plus rapide, base/small = bon équilibre (conseillé)
PHOEBUS_WHISPER_MODEL=small

# Mode IA : local_first priorise Ollama/local puis bascule cloud si nécessaire.
PHOEBUS_BRAIN_MODE=local_first
PHOEBUS_LOCAL_FIRST=1
PHOEBUS_OLLAMA_TIMEOUT=8

# Durée pendant laquelle PHOEBUS accepte les relances sans répéter le wake word.
PHOEBUS_CONVERSATION_WINDOW_SECONDS=45

# Garde-fou anti-boucle pour les actions JSON produites par l'IA.
PHOEBUS_ACTION_GUARD=1
PHOEBUS_ACTION_GUARD_MAX_ACTIONS=8
PHOEBUS_ACTION_GUARD_MAX_IDENTICAL=2
PHOEBUS_AGENT_MAX_TURNS=8
PHOEBUS_AGENT_MAX_REPLANS=2

# ───────────────────────────────────────────────────────────────────────────
# 👁️ VISION AUGMENTÉE — Super-Pouvoir #1 (Caméras Multiples)
# ───────────────────────────────────────────────────────────────────────────

# Activation caméras réseau
PHOEBUS_ENABLE_NETWORK_CAMERAS=1

# Timeout pour scan réseau (secondes)
PHOEBUS_CAMERA_SCAN_TIMEOUT=5.0

# Fichier de stockage des caméras découvertes
PHOEBUS_CAMERA_STORAGE=phoebus_cameras.json

# IP du téléphone (pour IP Webcam ou streaming)
PHOEBUS_PHONE_IP=192.168.1.100

# IP du NVR/caméra principale (optionnel)
PHOEBUS_NVR_IP=

# Activation reconnaissance faciale
PHOEBUS_ENABLE_FACE_RECOGNITION=1

# ───────────────────────────────────────────────────────────────────────────
# 🛡️ SENTINELLE — Super-Pouvoir #3 (Multi-Utilisateurs + Biométrie)
# ───────────────────────────────────────────────────────────────────────────

# Activation reconnaissance multi-utilisateurs (identification vocale)
PHOEBUS_MULTI_USER=1

# Seuil de confiance pour identification (0.0-1.0)
PHOEBUS_SPEAKER_THRESHOLD=0.75

# ───────────────────────────────────────────────────────────────────────────
# 🌍 TRADUCTEUR UNIVERSEL — Super-Pouvoir #4
# ───────────────────────────────────────────────────────────────────────────

# Activation traducteur streaming temps réel
PHOEBUS_ENABLE_TRANSLATOR=1

# Langue cible par défaut (en/es/de/ja/etc)
PHOEBUS_TRANSLATOR_DEFAULT_LANG=en

# Cache traductions (fichier ou Redis)
PHOEBUS_TRANSLATOR_CACHE=1

# ───────────────────────────────────────────────────────────────────────────
# 🎭 ANIMUS — Super-Pouvoir #6 (Avatar Holographique)
# ───────────────────────────────────────────────────────────────────────────

# Activation synchronisation lèvres (Lipsync)
PHOEBUS_ENABLE_LIPSYNC=1

# Qualité avatar (low/medium/high)
PHOEBUS_AVATAR_QUALITY=high

# FPS cible pour animations
PHOEBUS_AVATAR_FPS=60

# ───────────────────────────────────────────────────────────────────────────
# 🌀 POLYMORPHE — Super-Pouvoir #7 (Morphes Géométriques)
# ───────────────────────────────────────────────────────────────────────────

# Morphes disponibles: spider, matrix, galaxy, ironman (activés par défaut tous)
PHOEBUS_ENABLED_MORPHS=spider,matrix,galaxy,ironman

# Durée transition morphe (secondes)
PHOEBUS_MORPH_TRANSITION_DURATION=2.0

# ───────────────────────────────────────────────────────────────────────────
# 🔐 HOME ASSISTANT DOMOTIQUE
# ───────────────────────────────────────────────────────────────────────────

HA_URL=http://192.168.1.50:8123
HA_TOKEN=votre_token_ha_ici

# ───────────────────────────────────────────────────────────────────────────
# 🌐 SERVEURS PHOEBUS
# ───────────────────────────────────────────────────────────────────────────

# Port WebSocket principal
DEFAULT_WS_PORT=8765

# Port serveur mobile
DEFAULT_MOBILE_PORT=8766

# Token sécurité WebSocket (changer immédiatement!)
PHOEBUS_WS_TOKEN=CHANGE_MOI_IMMEDIATEMENT

# Authentification WebSocket requise (1/0)
WS_AUTH_REQUIRED=0

# ───────────────────────────────────────────────────────────────────────────
# 📊 MÉTRIQUES & LOGS
# ───────────────────────────────────────────────────────────────────────────

# Fichier liste appareils PHOEBUS
PHOEBUS_DEVICES_FILE=phoebus_devices.json

# Fichier audit (JSON Lines)
PHOEBUS_AUDIT_FILE=logs/audit.jsonl

# ───────────────────────────────────────────────────────────────────────────
# 🔊 AUDIO & TTS
# ───────────────────────────────────────────────────────────────────────────

# Modèle voix Edge TTS (fr-FR-DeniseNeural par défaut)
PHOEBUS_VOICE_EDGE=fr-FR-DeniseNeural

# Débit parole (0.8-1.5)
PHOEBUS_VOICE_RATE=1.0

# ───────────────────────────────────────────────────────────────────────────
# 🎬 FRONTEND & INTERFACE
# ───────────────────────────────────────────────────────────────────────────

# Port Vite dev server
VITE_PORT=5173

# ───────────────────────────────────────────────────────────────────────────
# 🚀 OPTIMISATIONS PERFORMANCE
# ───────────────────────────────────────────────────────────────────────────

# Cache LLM (vitesse accélérée pour réponses récurrentes)
PHOEBUS_RESPONSE_CACHE_ENABLED=1

# Cache TTL (secondes)
PHOEBUS_RESPONSE_CACHE_TTL=3600

# Streaming IA (parole par phrase au fur et à mesure)
PHOEBUS_ENABLE_IA_STREAMING=1

# Parallélisation STT + RAG
PHOEBUS_ENABLE_PARALLEL_PROCESSING=1

# ───────────────────────────────────────────────────────────────────────────
# ⚡ WAKE WORD DÉTECTION (100% local, gratuit)
# ───────────────────────────────────────────────────────────────────────────

# Activation wake word (\"PHOEBUS\" ou \"Jarvis\")
PHOEBUS_WAKE_ENABLED=1

# ───────────────────────────────────────────────────────────────────────────
# 🔍 MÉMOIRE LONG TERME (RAG - Retrieval Augmented Generation)
# ───────────────────────────────────────────────────────────────────────────

# Activation RAG (souvenirs persistants)
PHOEBUS_ENABLE_RAG=1

# Vector DB (chromadb par défaut, local)
PHOEBUS_VECTOR_DB=chromadb

# ───────────────────────────────────────────────────────────────────────────
# 🛡️ SÉCURITÉ & CONTRÔLE D'ACCÈS
# ───────────────────────────────────────────────────────────────────────────

# Créateur autorisé (pré-configuré)
PHOEBUS_CREATOR_NAME=Floriace

# Mode sécurité (open/restricted/paranoid)
PHOEBUS_SECURITY_MODE=restricted

# ═══════════════════════════════════════════════════════════════════════════
# 📝 NOTES DE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. LMARENA
#    - Clone le repo: cd external && git clone https://github.com/CloudWaddie/LMArenaBridge.git
#    - Remplir config.json avec vos credentials
#    - Lancer avec: python scripts/arena_bridge.py start
#
# 2. AUDIO
#    - macOS: brew install portaudio
#    - Linux: sudo apt install portaudio19-dev
#    - Windows: install.py gère automatiquement
#
# 3. HOME ASSISTANT
#    - URL locale (http://192.168.1.X:8123) ou cloud
#    - Générer token via Home Assistant UI
#
# 4. SÉCURITÉ
#    - Changer PHOEBUS_WS_TOKEN en production
#    - Utiliser WS_AUTH_REQUIRED=1 en réseau ouvert
#
# 5. PERFORMANCE
#    - PHOEBUS_BRAIN_MODE=speed pour latence ultra-faible
#    - PHOEBUS_BRAIN_MODE=smart pour meilleure qualité (LMArena prioritaire)
#    - PHOEBUS_BRAIN_MODE=privacy pour 100% local
#
